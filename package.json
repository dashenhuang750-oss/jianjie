{
  "name": "personal-profile-ai",
  "version": "1.0.0",
  "private": true,
  "description": "A public personal profile site with an AI-style Q&A assistant.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "test": "node --test",
    "check": "node --check server.js && node scripts/validate-config.js && tsc --noEmit && vite build && npm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
